---
import SiteLayout from '../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL;
---
<SiteLayout title="Employers — Sentinel Agency" description="Austin recruiting and staffing support for direct hire, executive search, contract staffing and hard-to-fill roles.">
<section class="hero wrap"><div><p class="eyebrow">FOR EMPLOYERS · AUSTIN, TEXAS</p><h1>Build the team the work actually requires.</h1><p class="lede">Sentinel helps employers define the role, map the market, qualify candidates and keep the process moving from first brief through accepted offer.</p><div class="actions"><a class="btn primary" href={`${base}contact?for=employer`}>Start a search →</a><a class="btn" href={`${base}jobs`}>See candidate-facing roles</a></div></div></section>
<section class="wrap section"><p class="eyebrow">ENGAGEMENT MODELS</p><div class="cards"><article><span>01</span><h3>Retained search</h3><p>Focused, high-touch search for leadership, confidential and business-critical hires.</p></article><article><span>02</span><h3>Contingent direct hire</h3><p>Targeted recruiting when you need qualified options without adding internal recruiter load.</p></article><article><span>03</span><h3>Contract staffing</h3><p>Flexible contract and contract-to-hire capacity for launches, backfills and project work.</p></article><article><span>04</span><h3>Market intelligence</h3><p>Compensation ranges, target-company maps, talent availability and role calibration before launch.</p></article></div></section>
<section class="wrap section two"><div><p class="eyebrow">WHAT WE NEED</p><h2>A usable brief beats a long job description.</h2><p>We calibrate on outcomes, must-have evidence, location, compensation, interview design, work authorization and the tradeoffs you can actually make.</p></div><div class="list"><div><span>01</span><b>Outcomes & scope</b><i>↗</i></div><div><span>02</span><b>Compensation & level</b><i>↗</i></div><div><span>03</span><b>Interview evidence</b><i>↗</i></div><div><span>04</span><b>Timeline & ownership</b><i>↗</i></div></div></section>
</SiteLayout>
